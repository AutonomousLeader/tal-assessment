PORT=3001
NODE_ENV=development
KIT_API_SECRET=
DATA_DIR=./data

# Public origin used to build shareable result links (/r/<id>)
PUBLIC_BASE_URL=https://assessment.theautonomousleader.com

# Admin console at /admin. Without ADMIN_PASSWORD the console stays disabled.
ADMIN_PASSWORD=
# Optional: keeps admin sign-ins alive across restarts. Any long random string.
ADMIN_SESSION_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# When RESEND_API_KEY is set, the app sends the funnel emails itself (results,
# nurture, upsell, retake, outreach) and the email scheduler turns on. Leave it
# blank to keep email off (Kit keeps handling sends during the parallel run).
RESEND_API_KEY=
# The From address. Use a dedicated sending subdomain you've verified in Resend.
RESEND_FROM=The Autonomous Leader <jonathan@mail.theautonomousleader.com>
# Optional Reply-To (a monitored inbox). Leave blank for none.
RESEND_REPLY_TO=

# ── DB backup (scripts/backup-db.js) ────────────────────────────────────────
# Where dated SQLite backups are written, and how many to keep.
BACKUP_DIR=./data/backups
BACKUP_KEEP=30
