PORT=3001
NODE_ENV=development
KIT_API_SECRET=
DATA_DIR=./data

# Public origin used to build shareable result links (/r/<id>)
PUBLIC_BASE_URL=https://assessment.theautonomousleader.com

# Admin console at /admin. Without ADMIN_PASSWORD the console stays disabled.
ADMIN_PASSWORD=
# Optional: keeps admin sign-ins alive across restarts. Any long random string.
ADMIN_SESSION_SECRET=
